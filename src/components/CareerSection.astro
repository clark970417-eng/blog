---
import type { CareerEntry } from '../data/portfolio';

interface Props {
  career: CareerEntry[];
}

const { career } = Astro.props;
---

<section id="career">
  <div class="section-label">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    経歴 <span data-i18n="careerSub">Timeline</span>
  </div>
  <ol class="timeline-list">
    {career.map((item, idx) => (
      <li class="timeline-entry" data-career-idx={idx}>
        <div class="timeline-date">
          <time>{item.date}</time>
        </div>
        <div class="timeline-main">
          <div class="timeline-head">
            <strong>{item.title}</strong>
            <span class="timeline-tag">#{item.tag}</span>
          </div>
          <small class="timeline-desc">{item.desc}</small>
        </div>
      </li>
    ))}
  </ol>
</section>
