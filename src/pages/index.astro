      // 3) lumen-stage live photo color-grading deck (EV, VIB, CON)
      const lumenCard = document.querySelector('.gh-card-lumen-stage') as HTMLElement | null;
      const lumenSlider = document.getElementById('lumen-brightness') as HTMLInputElement | null;
      const lumenVibSlider = document.getElementById('lumen-vib') as HTMLInputElement | null;
      const lumenConSlider = document.getElementById('lumen-contrast') as HTMLInputElement | null;
      const lumenEv = document.getElementById('lumen-ev');
      const lumenVibVal = document.getElementById('lumen-vib-val');
      const lumenConVal = document.getElementById('lumen-con-val');
      const lumenDimmer = document.getElementById('lumen-dimmer') as HTMLElement | null;

      const updateLumenLighting = () => {
        if (!lumenSlider) return;
        const b = Number(lumenSlider.value);
        const v = Number(lumenVibSlider?.value ?? 100);
        const c = Number(lumenConSlider?.value ?? 100);

        const normB = (b - 35) / (130 - 35);
        const normV = v / 200;
        const normC = (c - 65) / (140 - 65);
        lumenSlider.style.setProperty('--fill', `${Math.round(normB * 100)}%`);
        lumenVibSlider?.style.setProperty('--fill', `${Math.round(normV * 100)}%`);
        lumenConSlider?.style.setProperty('--fill', `${Math.round(normC * 100)}%`);
        if (lumenEv) lumenEv.textContent = `${b}%`;
        if (lumenVibVal) lumenVibVal.textContent = `${v}%`;
        if (lumenConVal) lumenConVal.textContent = `${c}%`;

        if (lumenCard) {
          lumenCard.style.setProperty('--lumen-glow', `${(0.05 + normB * 0.16).toFixed(2)}`);
          lumenCard.style.setProperty('--lumen-tint', '234, 185, 120');
        }

        if (lumenDimmer) {
          if (b === 100 && v === 100 && c === 100) {
            lumenDimmer.style.opacity = '0';
            lumenDimmer.style.backgroundColor = 'transparent';
            lumenDimmer.style.backdropFilter = 'none';
            lumenDimmer.style.setProperty('-webkit-backdrop-filter', 'none');
          } else {
            const filters: string[] = [];
            if (b !== 100) filters.push(`brightness(${(b / 100).toFixed(2)})`);
            const sat = v >= 100 ? 1 + ((v - 100) / 100) * 1.15 : v / 100;
            const vibCon = v >= 100 ? 1 + ((v - 100) / 100) * 0.12 : 1 + ((v - 100) / 100) * 0.05;
            const totalCon = (c / 100) * vibCon;
            if (v !== 100) filters.push(`saturate(${sat.toFixed(2)})`);
            if (c !== 100 || v !== 100) filters.push(`contrast(${totalCon.toFixed(2)})`);
            const bf = filters.length ? filters.join(' ') : 'none';
            lumenDimmer.style.backgroundColor = 'transparent';
            lumenDimmer.style.backdropFilter = bf;
            lumenDimmer.style.setProperty('-webkit-backdrop-filter', bf);
            lumenDimmer.style.opacity = '1';
          }
        }
      };

      lumenSlider?.addEventListener('input', updateLumenLighting);
      lumenVibSlider?.addEventListener('input', updateLumenLighting);
      lumenConSlider?.addEventListener('input', updateLumenLighting);
      lumenEv?.addEventListener('click', () => {
