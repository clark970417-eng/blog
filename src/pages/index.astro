      // 5) Croc Runner Mini Arcade Game
      (() => {
        const canvas = document.getElementById('croc-canvas') as HTMLCanvasElement | null;
        const overlay = document.getElementById('game-overlay');
        const overlayTitle = document.getElementById('game-overlay-title');
        const overlaySub = document.getElementById('game-overlay-sub');
        const startBtn = document.getElementById('game-start-btn');
        const scoreEl = document.getElementById('game-score');
        const bestEl = document.getElementById('game-best');
        if (!canvas || !overlay || !startBtn) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const crocImg = new Image();
        crocImg.src = document.querySelector<HTMLImageElement>('.avatar-img')?.src || '/avatar.png';

        let state: 'idle' | 'running' | 'gameover' = 'idle';
        let score = 0;
        let best = Number(localStorage.getItem('croc_best') || '0');
        if (bestEl) bestEl.textContent = String(best);

        let W = 680;
        let H = 200;
        const groundY = 166;
        let speed = 290;
        let player = { x: 64, y: groundY - 38, vy: 0, w: 38, h: 38, jumps: 0 };
        let obstacles: { x: number; w: number; h: number; kind: 'tripod' | 'cone' | 'bug' }[] = [];
        let stars: { x: number; y: number; r: number; collected: boolean }[] = [];
        let dust: { x: number; y: number; vx: number; vy: number; life: number; color: string }[] = [];
        let spawnTimer = 0.9;
        let groundOffset = 0;
        let lastTime = 0;
        let rafId = 0;

        const fitCanvas = () => {
          const rect = canvas.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = Math.max(300, Math.round(rect.width));
          H = 200;
          canvas.width = W * dpr;
          canvas.height = H * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        fitCanvas();
        window.addEventListener('resize', fitCanvas);

        const spawnDust = (x: number, y: number, color: string, count = 6) => {
          for (let i = 0; i < count; i++) {
            dust.push({
              x,
              y,
              vx: -60 - Math.random() * 90,
              vy: -30 - Math.random() * 80,
              life: 0.35 + Math.random() * 0.2,
              color,
            });
          }
        };

        const jump = () => {
          if (state !== 'running') {
            startGame();
            return;
          }
          if (player.jumps < 2) {
            player.vy = player.jumps === 0 ? -510 : -440;
            player.jumps++;
            spawnDust(player.x + player.w * 0.4, player.y + player.h, '#4f759b', 6);
          }
        };

        const startGame = () => {
          fitCanvas();
          state = 'running';
          score = 0;
          speed = 295;
          player = { x: Math.min(64, W * 0.14), y: groundY - 38, vy: 0, w: 38, h: 38, jumps: 0 };
          obstacles = [];
          stars = [];
          dust = [];
          spawnTimer = 0.85;
          if (scoreEl) scoreEl.textContent = '0';
          overlay.classList.add('is-hidden');
          lastTime = performance.now();
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(loop);
        };

        const endGame = () => {
          state = 'gameover';
          const finalScore = Math.floor(score);
          if (finalScore > best) {
            best = finalScore;
            localStorage.setItem('croc_best', String(best));
            if (bestEl) bestEl.textContent = String(best);
          }
          if (overlayTitle) overlayTitle.textContent = `Game Over · ${finalScore}`;
          if (overlaySub) overlaySub.textContent = `Best: ${best}`;
          startBtn.textContent = '↻ Play Again';
          overlay.classList.remove('is-hidden');
        };

        const drawScene = () => {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          const gridCol = isDark ? 'rgba(90, 105, 130, 0.18)' : 'rgba(185, 205, 225, 0.42)';
          const ink = isDark ? '#e6edf3' : '#2c3440';
          const muted = isDark ? '#8d96a0' : '#6e7b8b';
          const accentBlue = isDark ? '#8cb4dc' : '#4f759b';
          const accentPink = isDark ? '#e29ab8' : '#b86b8d';

          ctx.clearRect(0, 0, W, H);

          // Subtle scrolling graph lines
          ctx.strokeStyle = gridCol;
          ctx.lineWidth = 1;
          const step = 32;
          const ox = -(groundOffset % step);
          ctx.beginPath();
          for (let x = ox; x < W; x += step) {
            ctx.moveTo(x, 0);
            ctx.lineTo(x, H);
          }
          for (let y = 24; y < H; y += step) {
            ctx.moveTo(0, y);
            ctx.lineTo(W, y);
          }
          ctx.stroke();

          // Ground horizon line
          ctx.strokeStyle = muted;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(0, groundY);
          ctx.lineTo(W, groundY);
          ctx.stroke();

          // Collectible stars
          stars.forEach((s) => {
            if (s.collected) return;
            ctx.save();
            ctx.translate(s.x, s.y);
            ctx.fillStyle = '#eab308';
            ctx.beginPath();
            for (let i = 0; i < 5; i++) {
              const a1 = (i * 2 * Math.PI) / 5 - Math.PI / 2;
              const a2 = a1 + Math.PI / 5;
              ctx.lineTo(Math.cos(a1) * s.r, Math.sin(a1) * s.r);
              ctx.lineTo(Math.cos(a2) * (s.r * 0.45), Math.sin(a2) * (s.r * 0.45));
            }
            ctx.closePath();
            ctx.fill();
            ctx.restore();
          });

          // Obstacles (Tripod camera, VEX cone, Bug block)
          obstacles.forEach((o) => {
            const bx = o.x;
            const by = groundY - o.h;
            if (o.kind === 'cone') {
              ctx.fillStyle = accentPink;
              ctx.beginPath();
              ctx.moveTo(bx + o.w / 2, by);
              ctx.lineTo(bx + o.w - 2, groundY - 4);
              ctx.lineTo(bx + 2, groundY - 4);
              ctx.closePath();
              ctx.fill();
              ctx.fillStyle = ink;
              ctx.fillRect(bx, groundY - 4, o.w, 4);
            } else if (o.kind === 'tripod') {
              ctx.strokeStyle = ink;
              ctx.lineWidth = 2.2;
              ctx.beginPath();
              ctx.moveTo(bx + o.w / 2, by + 10);
              ctx.lineTo(bx + 3, groundY);
              ctx.moveTo(bx + o.w / 2, by + 10);
              ctx.lineTo(bx + o.w - 3, groundY);
              ctx.moveTo(bx + o.w / 2, by + 10);
              ctx.lineTo(bx + o.w / 2, groundY - 2);
              ctx.stroke();
              ctx.fillStyle = accentBlue;
              ctx.fillRect(bx + 3, by, o.w - 6, 12);
              ctx.fillStyle = '#ffffff';
              ctx.beginPath();
              ctx.arc(bx + o.w / 2 + 2, by + 6, 3, 0, Math.PI * 2);
              ctx.fill();
            } else {
              ctx.fillStyle = accentBlue;
              ctx.beginPath();
              ctx.roundRect(bx, by, o.w, o.h, 5);
              ctx.fill();
              ctx.fillStyle = '#ffffff';
              ctx.font = '700 10px monospace';
              ctx.textAlign = 'center';
              ctx.fillText('</>', bx + o.w / 2, by + o.h / 2 + 3.5);
            }
          });

          // Dust particles
          dust.forEach((d) => {
            ctx.globalAlpha = Math.max(0, d.life * 2);
            ctx.fillStyle = d.color;
            ctx.fillRect(d.x, d.y, 4, 4);
            ctx.globalAlpha = 1;
          });

          // Crocodile Player (avatar.png rounded badge)
          ctx.save();
          const cx = player.x + player.w / 2;
          const cy = player.y + player.h / 2;
          ctx.translate(cx, cy);
          const tilt = player.y < groundY - player.h ? Math.max(-0.18, Math.min(0.18, player.vy * 0.00035)) : Math.sin(groundOffset * 0.06) * 0.05;
          ctx.rotate(tilt);
          ctx.beginPath();
          ctx.roundRect(-player.w / 2, -player.h / 2, player.w, player.h, 9);
          ctx.clip();
          if (crocImg.complete && crocImg.naturalWidth > 0) {
            ctx.drawImage(crocImg, -player.w / 2, -player.h / 2, player.w, player.h);
          } else {
            ctx.fillStyle = '#22c55e';
            ctx.fillRect(-player.w / 2, -player.h / 2, player.w, player.h);
          }
          ctx.restore();
          ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.25)' : 'rgba(44,52,64,0.22)';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.roundRect(player.x, player.y, player.w, player.h, 9);
          ctx.stroke();
        };

        const loop = (now: number) => {
          if (state !== 'running') return;
          const dt = Math.min(0.04, (now - lastTime) / 1000);
          lastTime = now;

          speed = Math.min(540, speed + dt * 11);
          score += dt * 14;
          groundOffset += speed * dt;
          if (scoreEl) scoreEl.textContent = String(Math.floor(score));

          // Player physics
          player.vy += 1550 * dt;
          player.y += player.vy * dt;
          if (player.y >= groundY - player.h) {
            if (player.jumps > 0 && player.vy > 180) {
              spawnDust(player.x + player.w * 0.5, groundY, '#b86b8d', 4);
            }
            player.y = groundY - player.h;
            player.vy = 0;
            player.jumps = 0;
          }

          // Spawn obstacles & stars
          spawnTimer -= dt;
          if (spawnTimer <= 0) {
            const kinds: ('tripod' | 'cone' | 'bug')[] = ['tripod', 'cone', 'bug'];
            const kind = kinds[Math.floor(Math.random() * kinds.length)];
            const w = kind === 'bug' ? 28 : 26;
            const h = kind === 'tripod' ? 34 : kind === 'cone' ? 28 : 26;
            obstacles.push({ x: W + 24, w, h, kind });
            if (Math.random() < 0.55) {
              stars.push({ x: W + 38, y: groundY - h - 42 - Math.random() * 24, r: 8, collected: false });
            }
            spawnTimer = Math.max(0.75, 1.55 - (speed - 295) / 550) + Math.random() * 0.45;
          }

          // Move & collide
          const pad = 7;
          for (let i = obstacles.length - 1; i >= 0; i--) {
            const o = obstacles[i];
            o.x -= speed * dt;
            if (o.x + o.w < -20) {
              obstacles.splice(i, 1);
              continue;
            }
            if (
              player.x + pad < o.x + o.w - 3 &&
              player.x + player.w - pad > o.x + 3 &&
              player.y + pad < groundY &&
              player.y + player.h - 4 > groundY - o.h + 3
            ) {
              drawScene();
              endGame();
              return;
            }
          }

          for (let i = stars.length - 1; i >= 0; i--) {
            const s = stars[i];
            s.x -= speed * dt;
            if (s.x < -20) {
              stars.splice(i, 1);
              continue;
            }
            if (!s.collected && Math.hypot(player.x + player.w / 2 - s.x, player.y + player.h / 2 - s.y) < 24) {
              s.collected = true;
              score += 25;
              spawnDust(s.x, s.y, '#eab308', 7);
            }
          }

          for (let i = dust.length - 1; i >= 0; i--) {
            const d = dust[i];
            d.x += d.vx * dt;
            d.y += d.vy * dt;
            d.life -= dt;
            if (d.life <= 0) dust.splice(i, 1);
          }

          drawScene();
          rafId = requestAnimationFrame(loop);
        };

        crocImg.addEventListener('load', () => {
          if (state === 'idle') drawScene();
        });
        drawScene();

        startBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          startGame();
        });
        canvas.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          jump();
        });
        window.addEventListener('keydown', (e) => {
          if (state === 'running' && (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW')) {
            e.preventDefault();
            jump();
          }
        });
      })();
    </script>
  </body>
</html>
