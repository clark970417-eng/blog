      // 3) lumen-stage live website lighting & optics studio (Brightness, Kelvin Temp, Saturation)
      const lumenCard = document.querySelector('.gh-card-lumen-stage') as HTMLElement | null;
      const lumenSlider = document.getElementById('lumen-brightness') as HTMLInputElement | null;
      const lumenTempSlider = document.getElementById('lumen-temp') as HTMLInputElement | null;
      const lumenSatSlider = document.getElementById('lumen-sat') as HTMLInputElement | null;
      const lumenEv = document.getElementById('lumen-ev');
