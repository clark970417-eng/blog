      let selectedChipKey = '';
      const applySiteLang = (lang: 'en' | 'zh' | 'ja') => {
        currentLang = lang;
        const t = i18nData[lang];
        document.documentElement.lang = t.htmlLang;
        const bioEl = document.querySelector('[data-i18n="bio"]');
        if (bioEl) bioEl.textContent = t.bio;
        const welcomeEl = document.querySelector('[data-i18n="welcome"]');
        if (welcomeEl) welcomeEl.textContent = t.welcome;
        const worksSubEl = document.querySelector('[data-i18n="worksSub"]');
        if (worksSubEl) worksSubEl.textContent = t.worksSub;
        const photoSubEl = document.querySelector('[data-i18n="photoSub"]');
        if (photoSubEl) photoSubEl.textContent = t.photoSub;
        const careerSubEl = document.querySelector('[data-i18n="careerSub"]');
        if (careerSubEl) careerSubEl.textContent = t.careerSub;
        const gameSubEl = document.querySelector('[data-i18n="gameSub"]');
        if (gameSubEl) gameSubEl.textContent = t.gameSub;
        const gamePromptEl = document.querySelector('[data-i18n="gamePrompt"]');
        if (gamePromptEl) gamePromptEl.textContent = t.gamePrompt;
        const miuIdleEl = document.querySelector('[data-i18n="miuIdle"]');
        if (miuIdleEl && !document.getElementById('miu-sakura-btn')?.classList.contains('is-active') && !document.getElementById('miu-helper-btn')?.classList.contains('is-active')) {
          miuIdleEl.textContent = t.miuIdle;
        }
        const vocaSubEl = document.getElementById('voca-toy-sub');
        if (vocaSubEl) vocaSubEl.textContent = t.vocaSub;
        Object.entries(t.repos).forEach(([repo, text]) => {
          const el = document.querySelector(`[data-repo-desc="${repo}"]`);
          if (el) el.textContent = text;
        });
        t.career.forEach((item, idx) => {
          const card = document.querySelector(`[data-career-idx="${idx}"]`);
          if (!card) return;
          const strong = card.querySelector('strong');
          const small = card.querySelector('small');
          if (strong) strong.textContent = item.title;
          if (small) small.textContent = item.desc;
        });
        document.querySelectorAll('.chat-chip').forEach((chip) => {
          const key = chip.getAttribute('data-chip-i18n') as keyof typeof t.chips | null;
          if (!key) return;
          chip.textContent = t.chips[key];
          chip.setAttribute('data-q', t.chipQuestions[key]);
        });
        if (chatDraft && !chatDraft.classList.contains('has-text')) {
          chatDraft.textContent = t.draftPlaceholder;
        } else if (chatDraft && selectedChipKey) {
          selectedQuestion = t.chipQuestions[selectedChipKey as keyof typeof t.chipQuestions];
          chatDraft.textContent = selectedQuestion;
        }
        document.querySelectorAll('.toy-voca-btn').forEach((btn) => {
          btn.classList.toggle('is-active', btn.getAttribute('data-site-lang') === lang);
        });
      };

      document.querySelectorAll('.chat-chip').forEach((chip) => {
