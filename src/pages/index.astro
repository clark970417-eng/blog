---
import '../styles/global.css';
import rawAlbums from '../data/albums.json';
import photoSizes from '../data/photo-sizes.json';
import HeroWindow from '../components/HeroWindow.astro';
import WorksSection from '../components/WorksSection.astro';
import PhotographySection from '../components/PhotographySection.astro';
import CareerSection from '../components/CareerSection.astro';
import { SITE_URL, career, toThumbPath, works } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => (p.startsWith('/') ? `${base}${p}` : p);
const sizeMap = photoSizes as Record<string, [number, number]>;

const albums = rawAlbums.map((a: any) => ({
  ...a,
  cover: withBase(a.cover),
  coverThumb: withBase(toThumbPath(a.cover)),
  coverWidth: sizeMap[a.cover]?.[0] || 560,
  coverHeight: sizeMap[a.cover]?.[1] || 420,
  photos: (a.photos || []).map((p: string) => withBase(p)),
  thumbs: (a.photos || []).map((p: string) => withBase(toThumbPath(p))),
  thumbSizes: (a.photos || []).map((p: string) => sizeMap[p] || [560, 420]),
  credits: a.credits
    ? Object.fromEntries(Object.entries(a.credits).map(([k, v]) => [withBase(k), v]))
    : undefined,
}));

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'YuYing',
  alternateName: '4yuying',
  url: SITE_URL,
  image: `${SITE_URL}avatar.webp`,
  description: 'Taiwan, High School Senior, Photographer, Indie Dev & AI Engineer',
  sameAs: ['https://github.com/clark970417-eng', 'https://x.com/4yuying'],
  knowsAbout: ['Photography', 'Web Development', 'AI Engineering', 'TypeScript', 'JavaScript'],
};

const ogImageUrl = `${SITE_URL}og-card.png`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YuYing @4yuying</title>
    <meta name="description" content="Taiwan, High School Senior, Photographer, Indie Dev & AI Engineer" />
    <link rel="canonical" href={SITE_URL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content="YuYing @4yuying" />
    <meta property="og:description" content="Taiwan, High School Senior, Photographer, Indie Dev & AI Engineer" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="YuYing @4yuying" />
    <meta name="twitter:description" content="Taiwan, High School Senior, Photographer, Indie Dev & AI Engineer" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@500;700&family=Zen+Maru+Gothic:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href={withBase('/avatar.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="alternate" type="text/plain" href={withBase('/llms.txt')} title="LLMs.txt" />
    <meta name="theme-color" content="#f5f7fa" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'dark' ? '#0d1117' : '#f5f7fa');
        try {
          var q = new URLSearchParams(location.search).get('lang');
          var l = (q === 'en' || q === 'zh' || q === 'ja') ? q : localStorage.getItem('site_lang');
          if (l === 'zh' || l === 'ja') {
            document.documentElement.lang = l === 'zh' ? 'zh-Hant' : 'ja';
            document.documentElement.classList.add('i18n-pending');
            setTimeout(function () { document.documentElement.classList.remove('i18n-pending'); }, 1500);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="page-stack">
      <button id="reopen-window" class="reopen-pill" type="button">↺ Reopen yuying-profile.exe</button>
      <HeroWindow withBase={withBase} />
      <WorksSection works={works} withBase={withBase} />
      <PhotographySection albums={albums} />
      <CareerSection career={career} />

      <footer class="dock-wrap">
        <a href="#profile-window" id="back-top-link" class="back-top-link" data-i18n="backTop">↑ Top</a>
        <span class="copyright">© 2026 YuYing</span>
      </footer>
    </div>

    <canvas id="sakura-canvas" class="sakura-canvas" aria-hidden="true"></canvas>

    <!-- Album Lightbox Modal -->
    <div id="album-modal" class="album-modal" role="dialog" aria-modal="true" aria-label="Album Gallery">
      <div class="album-dialog">
        <div class="album-dialog-head">
          <div>
            <strong id="album-title"></strong>
            <span id="album-subtitle"></span>
          </div>
          <button id="album-close" class="album-close" type="button" aria-label="Close">×</button>
        </div>
        <div id="album-photos" class="album-photos"></div>
      </div>
    </div>

    <!-- Single Photo Fullscreen Slider -->
    <div id="photo-viewer" class="photo-viewer" role="dialog" aria-modal="true" aria-label="Photo Viewer">
      <span id="viewer-counter" class="viewer-counter" aria-live="polite"></span>
      <button id="viewer-close" class="viewer-btn viewer-close" type="button" aria-label="Close">×</button>
      <button id="viewer-prev" class="viewer-btn viewer-prev" type="button" aria-label="Previous">‹</button>
      <img id="viewer-img" src="" alt="" />
      <a id="viewer-credit" class="viewer-credit" href="#" target="_blank" rel="noreferrer"></a>
      <button id="viewer-next" class="viewer-btn viewer-next" type="button" aria-label="Next">›</button>
    </div>

    <div id="lumen-dimmer" class="lumen-dimmer" aria-hidden="true"></div>
    <button type="button" id="lumen-gizmo" class="lumen-gizmo" aria-label="Reset 3D viewport angle to 45°" title="3D view · Click to reset 45°">
      <svg viewBox="0 0 44 44" width="38" height="38" aria-hidden="true">
        <line id="gizmo-x" x1="22" y1="22" x2="36" y2="22" stroke="#ef4444" stroke-width="2" stroke-linecap="round"/>
        <line id="gizmo-y" x1="22" y1="22" x2="22" y2="8" stroke="#22c55e" stroke-width="2" stroke-linecap="round"/>
        <line id="gizmo-z" x1="22" y1="22" x2="14" y2="30" stroke="#3b82f6" stroke-width="2" stroke-linecap="round"/>
        <circle id="gizmo-tip-x" cx="36" cy="22" r="2.8" fill="#ef4444"/>
        <circle id="gizmo-tip-y" cx="22" cy="8" r="2.8" fill="#22c55e"/>
        <circle id="gizmo-tip-z" cx="14" cy="30" r="2.6" fill="#3b82f6"/>
        <circle cx="22" cy="22" r="2" fill="currentColor" opacity="0.45"/>
      </svg>
      <span id="gizmo-deg" class="gizmo-deg">45°</span>
    </button>

    <script define:vars={{ albums }}>
      window.__ALBUMS__ = albums;
    </script>
    <script>
      import {
        aiProviderMeta,
        i18nData,
        kanoArtistByLang,
        kanoReleases,
        vocaPairMap,
        type AiProviderId,
        type SiteLang,
      } from '../data/portfolio';

      // Typed hero prompt animation (skips immediately if reduced motion is preferred)
      const typedEl = document.getElementById('typed-name');
      if (typedEl) {
        const text = 'YuYing';
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          typedEl.textContent = '';
          let i = 0;
          const typeNext = () => {
            if (i < text.length) {
              typedEl.textContent += text[i++];
              setTimeout(typeNext, 110);
            }
          };
          setTimeout(typeNext, 250);
        }
      }

      // Align section headers and notebook-written timeline rows to the 32px background lines
      const syncNotebookGrid = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
        ['works', 'photography', 'career'].forEach((id) => {
          const sec = document.getElementById(id);
          if (!sec) return;
          sec.style.marginTop = '0px';
          const rawTop = sec.getBoundingClientRect().top + scrollTop;
          const mod = ((Math.round(rawTop) % 32) + 32) % 32;
          const delta = (16 - mod + 32) % 32;
          sec.style.marginTop = `${delta}px`;
        });
      };
      window.addEventListener('resize', syncNotebookGrid, { passive: true });
      document.fonts?.ready?.then(syncNotebookGrid);

      // Window chrome controls
      const profileWin = document.getElementById('profile-window');
      const reopenBtn = document.getElementById('reopen-window');
      const chatHint = document.getElementById('chat-hint');
      document.getElementById('dot-close')?.addEventListener('click', () => {
        profileWin?.classList.remove('fullscreen');
        profileWin?.classList.add('closed');
        reopenBtn?.classList.add('visible');
        document.body.style.overflow = '';
        chatHint?.classList.add('hidden');
        syncNotebookGrid();
      });
      reopenBtn?.addEventListener('click', () => {
        profileWin?.classList.remove('closed');
        reopenBtn.classList.remove('visible');
        syncNotebookGrid();
      });
      document.getElementById('dot-min')?.addEventListener('click', () => {
        profileWin?.classList.toggle('minimized');
        chatHint?.classList.add('hidden');
        syncNotebookGrid();
      });
      let lastFullTrigger: HTMLElement | null = null;
      const exitFullscreen = () => {
        if (!profileWin?.classList.contains('fullscreen')) return;
        profileWin.classList.remove('fullscreen');
        document.body.style.overflow = '';
        const fallback = document.getElementById('dot-max');
        const target = lastFullTrigger && lastFullTrigger.offsetParent !== null ? lastFullTrigger : fallback;
        target?.focus({ preventScroll: true });
      };
      const toggleFullscreen = (trigger?: HTMLElement | null) => {
        profileWin?.classList.remove('minimized');
        if (!profileWin?.classList.contains('fullscreen')) {
          lastFullTrigger = trigger || (document.activeElement as HTMLElement | null);
          profileWin?.classList.add('fullscreen');
          document.body.style.overflow = 'hidden';
          chatHint?.classList.add('hidden');
          (document.querySelector('.chat-chip') as HTMLElement | null)?.focus({ preventScroll: true });
        } else {
          exitFullscreen();
        }
      };
      document.getElementById('dot-max')?.addEventListener('click', (e) => toggleFullscreen(e.currentTarget as HTMLElement));
      chatHint?.addEventListener('click', (e) => toggleFullscreen(e.currentTarget as HTMLElement));

      // Theme + Pull-Cord Lamp 2D Physics
      const html = document.documentElement;
      const metaTheme = document.querySelector('meta[name="theme-color"]');
      const flipTheme = () => {
        html.classList.add('theme-anim');
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        if (metaTheme) metaTheme.setAttribute('content', next === 'dark' ? '#0d1117' : '#f5f7fa');
        setTimeout(() => html.classList.remove('theme-anim'), 380);
      };

      const cordLine = document.getElementById('cord-line');
      const cordKnob = document.getElementById('cord-knob');
      let kx = 0, ky = 74, vx = 0, vy = 0;
      let mx = 0, my = 47, mvx = 0, mvy = 0;
      const restY = 74;
      let dragging = false, pulled = false, startX = 0, startY = 0;
      let activeCordPointerId: number | null = null;
      let cordTouchDownX = 0, cordTouchDownY = 0;
      let lastCordTs = 0;
      let lastCordPath = '';
      let lastKnobTransform = '';
      let rafId = 0;

      const wakePhysics = () => {
        if (!rafId) {
          lastCordTs = 0;
          rafId = requestAnimationFrame(stepPhysics);
        }
      };

      const stepPhysics = (now = performance.now()) => {
        rafId = 0;
        const dt = lastCordTs ? Math.min((now - lastCordTs) / 16.6667, 2.5) : 1;
        lastCordTs = now;
        if (!dragging) {
          const damp = Math.pow(0.955, dt);
          vx = (vx + (0 - kx) * 0.08 * dt) * damp;
          vy = (vy + (restY - ky) * 0.1 * dt) * damp;
          kx += vx * dt;
          ky += vy * dt;
          if (ky < 30) { ky = 30; vy = Math.abs(vy) * 0.8; }
          if (ky > 140) { ky = 140; vy = -Math.abs(vy) * 0.8; }
          if (kx > 50) { kx = 50; vx = -Math.abs(vx) * 0.8; }
          if (kx < -160) { kx = -160; vx = Math.abs(vx) * 0.8; }
        }
        const targetMx = kx * 0.5;
        const targetMy = (20 + ky) * 0.5 + Math.max(0, 12 - (ky - 20) * 0.15);
        const mdamp = Math.pow(0.86, dt);
        mvx = (mvx + (targetMx - mx) * 0.22 * dt) * mdamp;
        mvy = (mvy + (targetMy - my) * 0.22 * dt) * mdamp;
        mx += mvx * dt;
        my += mvy * dt;

        if (cordLine && cordKnob) {
          const nextPath = `M 0 20 Q ${mx.toFixed(1)} ${my.toFixed(1)} ${kx.toFixed(1)} ${ky.toFixed(1)}`;
          const nextTransform = `translate3d(calc(-50% + ${kx.toFixed(1)}px), calc(-50% + ${ky.toFixed(1)}px), 0)`;
          if (nextPath !== lastCordPath) {
            cordLine.setAttribute('d', nextPath);
            lastCordPath = nextPath;
          }
          if (nextTransform !== lastKnobTransform) {
            cordKnob.style.transform = nextTransform;
            lastKnobTransform = nextTransform;
          }
        }
        const settled = !dragging &&
          Math.abs(kx) < 0.08 && Math.abs(ky - restY) < 0.08 &&
          Math.abs(vx) < 0.05 && Math.abs(vy) < 0.05 &&
          Math.abs(mvx) < 0.05 && Math.abs(mvy) < 0.05;
        if (!settled) {
          rafId = requestAnimationFrame(stepPhysics);
        } else {
          lastCordTs = 0;
        }
      };
      stepPhysics();

      cordKnob?.addEventListener('pointerdown', (e) => {
        activeCordPointerId = e.pointerId;
        cordTouchDownX = e.clientX;
        cordTouchDownY = e.clientY;
        if (e.pointerType === 'touch') return;
        e.preventDefault();
        dragging = true;
        pulled = false;
        startX = e.clientX - kx;
        startY = e.clientY - ky;
        try { cordKnob.setPointerCapture(e.pointerId); } catch {}
        wakePhysics();
      });

      window.addEventListener('pointermove', (e) => {
        if (!dragging || e.pointerId !== activeCordPointerId) return;
        const nx = Math.max(-160, Math.min(50, e.clientX - startX));
        const ny = Math.max(30, Math.min(140, e.clientY - startY));
        vx = nx - kx;
        vy = ny - ky;
        kx = nx;
        ky = ny;
        if (ky - restY >= 24 && !pulled) {
          pulled = true;
          flipTheme();
        }
      });

      const releaseCord = (e: PointerEvent) => {
        if (e.pointerId !== activeCordPointerId) return;
        const isCancel = e.type === 'pointercancel';
        activeCordPointerId = null;
        if (e.pointerType === 'touch') {
          dragging = false;
          if (!isCancel && Math.hypot(e.clientX - cordTouchDownX, e.clientY - cordTouchDownY) < 10) {
            vy = 6.5;
            vx = (Math.random() - 0.5) * 2.5;
            flipTheme();
            wakePhysics();
          }
          return;
        }
        if (!dragging) return;
        dragging = false;
        if (!isCancel && !pulled && Math.hypot(e.clientX - startX - kx, e.clientY - startY - ky) < 6 && Math.abs(ky - restY) < 8) {
          vy = 6.5;
          vx = (Math.random() - 0.5) * 2.5;
          flipTheme();
        }
        wakePhysics();
      };

      window.addEventListener('pointerup', releaseCord);
      window.addEventListener('pointercancel', releaseCord);

      // Multilingual UI state + AI provider persistence
      const chatMessages = document.getElementById('chat-messages');
      const chatDraft = document.getElementById('chat-draft');
      const aiProviderSel = document.getElementById('ai-provider') as HTMLSelectElement | null;
      let selectedQuestion = '';
      let selectedChipKey = '';
      let currentLang: SiteLang = 'en';

      const isValidLang = (val: string | null): val is SiteLang =>
        val === 'en' || val === 'zh' || val === 'ja';

      const applySiteLang = (lang: SiteLang, persist = true) => {
        currentLang = lang;
        if (persist) localStorage.setItem('site_lang', lang);
        const t = i18nData[lang];
        document.documentElement.lang = t.htmlLang;
        const bioEl = document.querySelector('[data-i18n="bio"]');
        if (bioEl) bioEl.textContent = t.bio;
        const welcomeEl = document.querySelector('[data-i18n="welcome"]');
        if (welcomeEl) welcomeEl.textContent = t.welcome;
        const worksSubEl = document.querySelector('[data-i18n="worksSub"]');
        if (worksSubEl) worksSubEl.textContent = t.worksSub;
        const photoSubEl = document.querySelector('[data-i18n="photoSub"]');
        if (photoSubEl) photoSubEl.textContent = t.photoSub;
        const careerSubEl = document.querySelector('[data-i18n="careerSub"]');
        if (careerSubEl) careerSubEl.textContent = t.careerSub;
        const chatHintText = document.querySelector('[data-i18n="chatHint"]');
        if (chatHintText) chatHintText.textContent = t.chatHint;
        if (reopenBtn) reopenBtn.textContent = t.reopen;
        const resetPhotosBtn = document.getElementById('photo-reset');
        if (resetPhotosBtn) resetPhotosBtn.textContent = t.resetPhotos;
        const backTopEl = document.getElementById('back-top-link');
        if (backTopEl) backTopEl.textContent = t.backTop;
        const gizmoBtn = document.getElementById('lumen-gizmo');
        if (gizmoBtn) gizmoBtn.title = t.gizmoTitle;
        const kanoPlayCtrl = document.getElementById('kano-play');
        if (kanoPlayCtrl) kanoPlayCtrl.title = t.playTitle;
        document.querySelectorAll('.photo-tape').forEach((tape) => {
          tape.setAttribute('aria-label', t.photoTapeLabel);
          tape.setAttribute('title', t.photoTapeTitle);
        });
        document.querySelectorAll('.polaroid-count').forEach((el) => {
          const kind = el.getAttribute('data-photo-kind');
          const count = el.getAttribute('data-photo-count');
          el.textContent = kind === 'Other' ? t.photoOther : `${count} ${t.photoCountSuffix}`;
        });
        const vocaPairEl = document.getElementById('voca-lang-pair');
        if (vocaPairEl) vocaPairEl.textContent = vocaPairMap[lang];
        const kanoArtistEl = document.getElementById('kano-track-album');
        if (kanoArtistEl) kanoArtistEl.textContent = kanoArtistByLang[lang];

        Object.entries(t.repos).forEach(([repo, text]) => {
          const el = document.querySelector(`[data-repo-desc="${repo}"]`);
          if (el) el.textContent = text;
          const card = document.querySelector(`.gh-pin-card[data-repo="${repo}"]`);
          if (card) card.setAttribute('aria-label', `${repo}: ${text} (opens GitHub)`);
        });
        t.career.forEach((item, idx) => {
          const card = document.querySelector(`[data-career-idx="${idx}"]`);
          if (!card) return;
          const strong = card.querySelector('strong');
          const small = card.querySelector('small');
          if (strong) strong.textContent = item.title;
          if (small) small.textContent = item.desc;
        });
        document.querySelectorAll('.chat-chip').forEach((chip) => {
          const key = chip.getAttribute('data-chip-i18n') as keyof typeof t.chips | null;
          if (!key) return;
          chip.textContent = t.chips[key];
          chip.setAttribute('data-q', t.chipQuestions[key]);
        });
        if (chatDraft && !chatDraft.classList.contains('has-text')) {
          chatDraft.textContent = t.draftPlaceholder;
        } else if (chatDraft && selectedChipKey) {
          selectedQuestion = t.chipQuestions[selectedChipKey as keyof typeof t.chipQuestions];
          chatDraft.textContent = selectedQuestion;
        }
        document.querySelectorAll('.toy-voca-btn').forEach((btn) => {
          const match = btn.getAttribute('data-site-lang') === lang;
          btn.classList.toggle('is-active', match);
          btn.setAttribute('aria-pressed', match ? 'true' : 'false');
        });
        document.documentElement.classList.remove('i18n-pending');
        syncNotebookGrid();
      };

      const urlLang = new URLSearchParams(window.location.search).get('lang');
      const savedLang = localStorage.getItem('site_lang');
      if (isValidLang(urlLang)) {
        applySiteLang(urlLang, false);
      } else if (isValidLang(savedLang) && savedLang !== 'en') {
        applySiteLang(savedLang, false);
      } else {
        document.documentElement.classList.remove('i18n-pending');
        syncNotebookGrid();
      }

      const savedProvider = localStorage.getItem('ai_provider') as AiProviderId | null;
      if (aiProviderSel && savedProvider && savedProvider in aiProviderMeta) {
        aiProviderSel.value = savedProvider;
      }
      aiProviderSel?.addEventListener('change', () => {
        localStorage.setItem('ai_provider', aiProviderSel.value);
      });

      document.querySelectorAll('.chat-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          selectedChipKey = chip.getAttribute('data-chip-i18n') || '';
          selectedQuestion = chip.getAttribute('data-q') || '';
          if (chatDraft) {
            chatDraft.textContent = selectedQuestion;
            chatDraft.classList.add('has-text');
          }
        });
      });

      // Prevent card HTML5 drag when interacting inside project mini widgets
      let activeDragDisabledCard: HTMLElement | null = null;
      document.addEventListener('pointerdown', (e) => {
        const toy = (e.target as HTMLElement | null)?.closest('.proj-toy');
        if (!toy) return;
        const card = toy.closest('.gh-pin-card') as HTMLElement | null;
        if (card) {
          card.draggable = false;
          activeDragDisabledCard = card;
        }
      });
      const restoreToyCardDrag = () => {
        if (activeDragDisabledCard) {
          activeDragDisabledCard.draggable = true;
          activeDragDisabledCard = null;
        }
      };
      document.addEventListener('pointerup', restoreToyCardDrag);
      document.addEventListener('pointercancel', restoreToyCardDrag);

      // 1) miu-pocket outdoor sakura diorama & interactive standee
      const sakuraBtn = document.getElementById('miu-sakura-toy');
      const sakuraScene = document.getElementById('miu-sakura-scene');
      const sakuraCanvas = document.getElementById('sakura-canvas') as HTMLCanvasElement | null;
      let sakuraActive = false;
      let sakuraRaf = 0;
      let lastPetalTs = 0;
      let sakuraW = window.innerWidth;
      let sakuraH = window.innerHeight;
      let sakuraDpr = Math.min(window.devicePixelRatio || 1, 2);
      const petals: { x: number; y: number; r: number; vx: number; vy: number; rot: number; vr: number; wobble: number }[] = [];

      const resizeSakura = () => {
        if (!sakuraCanvas) return;
        sakuraW = window.innerWidth;
        sakuraH = window.innerHeight;
        sakuraDpr = Math.min(window.devicePixelRatio || 1, 2);
        sakuraCanvas.width = Math.round(sakuraW * sakuraDpr);
        sakuraCanvas.height = Math.round(sakuraH * sakuraDpr);
        const ctx = sakuraCanvas.getContext('2d');
        ctx?.setTransform(sakuraDpr, 0, 0, sakuraDpr, 0, 0);
      };

      const drawPetals = (now = performance.now()) => {
        const ctx = sakuraCanvas?.getContext('2d');
        if (!sakuraActive || document.hidden || !ctx || !sakuraCanvas) {
          lastPetalTs = 0;
          return;
        }
        const dt = lastPetalTs ? Math.min((now - lastPetalTs) / 16.6667, 2.5) : 1;
        lastPetalTs = now;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        if (
          dpr !== sakuraDpr ||
          sakuraCanvas.width !== Math.round(window.innerWidth * dpr) ||
          sakuraCanvas.height !== Math.round(window.innerHeight * dpr)
        ) {
          resizeSakura();
        }
        ctx.clearRect(0, 0, sakuraW, sakuraH);
        petals.forEach((p, idx) => {
          p.wobble += 0.025 * dt;
          p.x += (p.vx + Math.sin(p.wobble) * 0.45) * dt;
          p.y += p.vy * dt;
          p.rot += p.vr * dt;
          if (p.y > sakuraH + 16) {
            p.y = -14;
            p.x = Math.random() * sakuraW;
          }
          if (p.x > sakuraW + 16) p.x = -14;
          if (p.x < -16) p.x = sakuraW + 14;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.fillStyle = idx % 3 === 0 ? 'rgba(249, 184, 208, 0.78)' : idx % 3 === 1 ? 'rgba(255, 214, 230, 0.82)' : 'rgba(244, 154, 188, 0.7)';
          ctx.beginPath();
          ctx.moveTo(0, -p.r);
          ctx.quadraticCurveTo(p.r * 0.85, -p.r * 0.25, 0, p.r * 0.85);
          ctx.quadraticCurveTo(-p.r * 0.85, -p.r * 0.25, 0, -p.r);
          ctx.fill();
          ctx.restore();
        });
        sakuraRaf = requestAnimationFrame(drawPetals);
      };

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(sakuraRaf);
          sakuraRaf = 0;
          lastPetalTs = 0;
        } else if (sakuraActive) {
          cancelAnimationFrame(sakuraRaf);
          lastPetalTs = 0;
          sakuraRaf = requestAnimationFrame(drawPetals);
        }
      });

      const toggleSakura = () => {
        if (!sakuraCanvas || !sakuraBtn) return;
        sakuraActive = !sakuraActive;
        sakuraBtn.classList.toggle('is-active', sakuraActive);
        sakuraScene?.classList.toggle('is-active', sakuraActive);
        sakuraBtn.setAttribute('aria-pressed', sakuraActive ? 'true' : 'false');
        sakuraCanvas.classList.toggle('is-active', sakuraActive);
        if (!sakuraActive) {
          cancelAnimationFrame(sakuraRaf);
          sakuraRaf = 0;
          lastPetalTs = 0;
          const ctx = sakuraCanvas.getContext('2d');
          ctx?.clearRect(0, 0, sakuraW, sakuraH);
          return;
        }
        resizeSakura();
        if (!petals.length) {
          for (let i = 0; i < 26; i++) {
            petals.push({
              x: Math.random() * sakuraW,
              y: Math.random() * sakuraH,
              r: 5 + Math.random() * 5,
              vx: -0.4 + Math.random() * 0.9,
              vy: 0.9 + Math.random() * 1.1,
              rot: Math.random() * Math.PI * 2,
              vr: (Math.random() - 0.5) * 0.04,
              wobble: Math.random() * Math.PI * 2,
            });
          }
        }
        cancelAnimationFrame(sakuraRaf);
        lastPetalTs = 0;
        sakuraRaf = requestAnimationFrame(drawPetals);
      };

      const miuCord = document.getElementById('miu-sakura-cord');
      if (sakuraBtn && miuCord) {
        let cordPointerId: number | null = null;
        let cordStartX = 0;
        let cordStartY = 0;
        let cordDragging = false;
        let cordMoved = false;
        let cordTriggered = false;
        sakuraBtn.addEventListener('pointerdown', (e) => {
          cordPointerId = e.pointerId;
          cordStartX = e.clientX;
          cordStartY = e.clientY;
          if (e.pointerType === 'touch') return;
          e.preventDefault();
          cordDragging = true;
          cordMoved = false;
          cordTriggered = false;
          miuCord.classList.add('is-dragging');
          try { sakuraBtn.setPointerCapture(e.pointerId); } catch {}
        });
        window.addEventListener('pointermove', (e) => {
          if (!cordDragging || e.pointerId !== cordPointerId) return;
          const dy = Math.max(-2, Math.min(20, e.clientY - cordStartY));
          if (Math.abs(dy) > 3) cordMoved = true;
          miuCord.style.setProperty('--cord-pull', `${dy.toFixed(1)}px`);
          if (dy >= 10 && !cordTriggered) {
            cordTriggered = true;
            toggleSakura();
          }
        });
        const releaseMiuCord = (e: PointerEvent) => {
          if (e.pointerId !== cordPointerId) return;
          const isCancel = e.type === 'pointercancel';
          cordPointerId = null;
          if (e.pointerType === 'touch') {
            if (!isCancel && Math.hypot(e.clientX - cordStartX, e.clientY - cordStartY) < 10) {
              toggleSakura();
            }
            return;
          }
          if (!cordDragging) return;
          cordDragging = false;
          miuCord.classList.remove('is-dragging');
          miuCord.style.setProperty('--cord-pull', '0px');
          if (!isCancel && !cordMoved) toggleSakura();
        };
        window.addEventListener('pointerup', releaseMiuCord);
        window.addEventListener('pointercancel', releaseMiuCord);
      }

      const standeeToy = document.getElementById('miu-standee-toy');
      standeeToy?.addEventListener('click', () => {
        standeeToy.classList.remove('is-hopping');
        void (standeeToy as HTMLElement).offsetWidth;
        standeeToy.classList.add('is-hopping');
      });

      // 2) VocaLume real website language translator
      const vocaShelf = document.querySelector('.orn-voca-shelf');
      document.querySelectorAll('.toy-voca-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-site-lang') as SiteLang | null;
          if (!lang) return;
          applySiteLang(lang, true);
          vocaShelf?.classList.remove('is-pulsing');
          void (vocaShelf as HTMLElement | null)?.offsetWidth;
          vocaShelf?.classList.add('is-pulsing');
        });
      });

      // 3) lumen-stage 3D studio lighting rig (KEY, CCT, ANG) + Blender axis gizmo
      const rootEl = document.documentElement;
      const lumenDeck = document.querySelector('.orn-lumen') as HTMLElement | null;
      const lumenCard = document.querySelector('.gh-card-lumen-stage') as HTMLElement | null;
      const lumenKeySlider = document.getElementById('lumen-key') as HTMLInputElement | null;
      const lumenCctSlider = document.getElementById('lumen-cct') as HTMLInputElement | null;
      const lumenAngSlider = document.getElementById('lumen-ang') as HTMLInputElement | null;
      const lumenKeyVal = document.getElementById('lumen-key-val');
      const lumenCctVal = document.getElementById('lumen-cct-val');
      const lumenAngVal = document.getElementById('lumen-ang-val');
      const lumenDimmer = document.getElementById('lumen-dimmer') as HTMLElement | null;
      const lumenGizmo = document.getElementById('lumen-gizmo') as HTMLButtonElement | null;
      const gizmoDeg = document.getElementById('gizmo-deg');
      const gizmoAxes: Array<[SVGLineElement | null, SVGCircleElement | null, [number, number, number]]> = [
        [document.getElementById('gizmo-x') as SVGLineElement | null, document.getElementById('gizmo-tip-x') as SVGCircleElement | null, [14, 0, 0]],
        [document.getElementById('gizmo-y') as SVGLineElement | null, document.getElementById('gizmo-tip-y') as SVGCircleElement | null, [0, -14, 0]],
        [document.getElementById('gizmo-z') as SVGLineElement | null, document.getElementById('gizmo-tip-z') as SVGCircleElement | null, [0, 0, 14]],
      ];

      /** Interpolate studio Kelvin temperature into an RGB triple for beams & rim highlights. */
      const kelvinToRgb = (k: number): [number, number, number] => {
        if (k <= 5600) {
          const t = Math.max(0, Math.min(1, (k - 2800) / (5600 - 2800)));
          return [
            Math.round(255 - 8 * t),
            Math.round(168 + 74 * t),
            Math.round(78 + 162 * t),
          ];
        }
        const t = Math.max(0, Math.min(1, (k - 5600) / (7500 - 5600)));
        return [
          Math.round(247 - 117 * t),
          Math.round(242 - 48 * t),
          Math.round(240 + 15 * t),
        ];
      };

      const updateLumenLighting = () => {
        if (!lumenKeySlider) return;
        const key = Number(lumenKeySlider.value);
        const cct = Number(lumenCctSlider?.value ?? 5600);
        const ang = Number(lumenAngSlider?.value ?? 45);

        const normKey = (key - 35) / (140 - 35);
        const normCct = (cct - 2800) / (7500 - 2800);
        const normAng = ang / 360;
        lumenKeySlider.style.setProperty('--fill', `${Math.round(normKey * 100)}%`);
        lumenCctSlider?.style.setProperty('--fill', `${Math.round(normCct * 100)}%`);
        lumenAngSlider?.style.setProperty('--fill', `${Math.round(normAng * 100)}%`);
        if (lumenKeyVal) lumenKeyVal.textContent = `${key}%`;
        if (lumenCctVal) lumenCctVal.textContent = `${cct}K`;
        if (lumenAngVal) lumenAngVal.textContent = `${ang}°`;

        const [r, g, b] = kelvinToRgb(cct);
        const cctCss = `rgb(${r}, ${g}, ${b})`;
        lumenDeck?.style.setProperty('--cct-color', cct === 5600 ? '#cbd5e1' : cctCss);

        const rad = (ang * Math.PI) / 180;
        const hx = Math.cos(rad);
        const hy = -Math.sin(rad);
        const sx = -hx;
        const sy = -hy;
        const lx = 50 + hx * 42;
        const ly = 50 + hy * 42;

        if (lumenCard) {
          const glow = key === 100 && cct === 5600 && ang === 45 ? 0.14 : 0.08 + normKey * 0.18;
          const cardTint = cct === 5600 ? '234, 185, 120' : `${r}, ${g}, ${b}`;
          lumenCard.style.setProperty('--lumen-glow', glow.toFixed(2));
          lumenCard.style.setProperty('--lumen-tint', cardTint);
          lumenCard.style.setProperty('--lumen-pos-x', `${Math.round(lx)}%`);
          lumenCard.style.setProperty('--lumen-pos-y', `${Math.round(ly)}%`);
        }

        const is3d = ang !== 45;
        const delta = ((ang - 45) * Math.PI) / 180;
        const rotY = is3d ? Math.sin(delta) * 14 : 0;
        const rotX = is3d ? 5 + (1 - Math.cos(delta)) * 4.5 : 0;
        const isDefault = key === 100 && cct === 5600 && ang === 45;

        rootEl.classList.toggle('lumen-studio-on', !isDefault);
        rootEl.classList.toggle('lumen-3d-on', is3d);
        if (!isDefault) {
          rootEl.style.setProperty('--lumen-sx', sx.toFixed(3));
          rootEl.style.setProperty('--lumen-sy', sy.toFixed(3));
          rootEl.style.setProperty('--lumen-hx', hx.toFixed(3));
          rootEl.style.setProperty('--lumen-hy', hy.toFixed(3));
          rootEl.style.setProperty('--lumen-rgb', `${r}, ${g}, ${b}`);
        } else {
          ['--lumen-sx', '--lumen-sy', '--lumen-hx', '--lumen-hy', '--lumen-rgb'].forEach((prop) =>
            rootEl.style.removeProperty(prop)
          );
        }

        if (is3d) {
          rootEl.style.setProperty('--lumen-rx', `${rotX.toFixed(2)}deg`);
          rootEl.style.setProperty('--lumen-ry', `${rotY.toFixed(2)}deg`);
          const rxR = (rotX * Math.PI) / 180;
          const ryR = (rotY * Math.PI) / 180;
          gizmoAxes.forEach(([line, tip, [vx, vy, vz]]) => {
            const x1 = vx * Math.cos(ryR) + vz * Math.sin(ryR);
            const z1 = -vx * Math.sin(ryR) + vz * Math.cos(ryR);
            const y2 = vy * Math.cos(rxR) - z1 * Math.sin(rxR);
            const px = (22 + x1).toFixed(1);
            const py = (22 + y2).toFixed(1);
            line?.setAttribute('x2', px);
            line?.setAttribute('y2', py);
            tip?.setAttribute('cx', px);
            tip?.setAttribute('cy', py);
          });
          if (gizmoDeg) gizmoDeg.textContent = `${ang}°`;
        } else {
          rootEl.style.removeProperty('--lumen-rx');
          rootEl.style.removeProperty('--lumen-ry');
        }

        if (lumenDimmer) {
          if (isDefault) {
            lumenDimmer.style.opacity = '0';
            lumenDimmer.style.background = 'none';
          } else {
            const beamAlpha = key > 100 ? 0.14 + ((key - 100) / 40) * 0.14 : cct === 5600 ? 0.05 : 0.1 + normKey * 0.1;
            const centerDim = key < 100 ? ((100 - key) / 65) * 0.34 : 0;
            const darkEdge = key < 100 ? ((100 - key) / 65) * 0.52 : 0.06;
            const innerBg = centerDim > 0
              ? `rgba(8, 12, 24, ${centerDim.toFixed(2)})`
              : `rgba(${r}, ${g}, ${b}, ${beamAlpha.toFixed(2)})`;
            lumenDimmer.style.background = `radial-gradient(ellipse 68% 68% at ${lx.toFixed(1)}% ${ly.toFixed(1)}%, ${innerBg} 0%, rgba(${r}, ${g}, ${b}, ${(beamAlpha * 0.22).toFixed(2)}) 44%, rgba(8, 12, 24, ${darkEdge.toFixed(2)}) 100%)`;
            lumenDimmer.style.opacity = '1';
          }
        }
      };

      let lumenRaf = 0;
      const scheduleLumenUpdate = () => {
        if (lumenRaf) return;
        lumenRaf = requestAnimationFrame(() => {
          lumenRaf = 0;
          updateLumenLighting();
        });
      };

      const lumenSliders = [lumenKeySlider, lumenCctSlider, lumenAngSlider].filter(Boolean) as HTMLInputElement[];
      const stopLumenScrub = () => rootEl.classList.remove('lumen-scrubbing');
      lumenSliders.forEach((slider) => {
        slider.addEventListener('input', scheduleLumenUpdate);
        slider.addEventListener('pointerdown', () => rootEl.classList.add('lumen-scrubbing'));
      });
      document.addEventListener('pointerup', stopLumenScrub);
      document.addEventListener('pointercancel', stopLumenScrub);

      const lumenResets: Array<[HTMLInputElement | null, Element | null, string]> = [
        [lumenKeySlider, lumenKeyVal, '100'],
        [lumenCctSlider, lumenCctVal, '5600'],
        [lumenAngSlider, lumenAngVal, '45'],
        [lumenAngSlider, lumenGizmo, '45'],
      ];
      lumenResets.forEach(([slider, resetBtn, def]) => {
        resetBtn?.addEventListener('click', () => {
          if (!slider) return;
          rootEl.classList.remove('lumen-scrubbing');
          slider.value = def;
          updateLumenLighting();
        });
      });
      updateLumenLighting();

      // 4) kano-record-shelf authentic 3D album jewel box + playable audio preview
      const kanoCard = document.querySelector('.gh-card-kano-record-shelf') as HTMLElement | null;
      const kanoDeck = document.getElementById('kano-mini-deck') as HTMLElement | null;
      const kanoBase = kanoDeck?.getAttribute('data-base') || '/kano/';
      const kanoStateReleases = kanoReleases.map((r) => ({ ...r }));
      let kanoIdx = 0;
      let kanoPlaying = false;
      const kanoCoverImg = document.getElementById('kano-cover-img') as HTMLImageElement | null;
      const kanoDiscImg = document.getElementById('kano-disc-img') as HTMLImageElement | null;
      const kanoTitle = document.getElementById('kano-track-title');
      const kanoAlbum = document.getElementById('kano-track-album');
      const kanoPlayBtn = document.getElementById('kano-play');
      const kanoAudio = document.getElementById('kano-audio') as HTMLAudioElement | null;

      const pickRandomKanoIdx = (exclude = -1) => {
        if (kanoStateReleases.length <= 1) return 0;
        let next = Math.floor(Math.random() * kanoStateReleases.length);
        if (next === exclude) next = (next + 1 + Math.floor(Math.random() * (kanoStateReleases.length - 1))) % kanoStateReleases.length;
        return next;
      };

      const setPlayingUI = (playing: boolean) => {
        kanoPlaying = playing;
        kanoDeck?.classList.toggle('is-playing', playing);
        kanoPlayBtn?.classList.toggle('is-playing', playing);
        kanoPlayBtn?.setAttribute('aria-pressed', playing ? 'true' : 'false');
      };

      let kanoStatusTimer = 0;
      const startKanoPlayback = async () => {
        if (!kanoAudio) return;
        const r = kanoStateReleases[kanoIdx];
        if (kanoAudio.src !== r.preview) kanoAudio.src = r.preview;
        try {
          await kanoAudio.play();
          clearTimeout(kanoStatusTimer);
          if (kanoAlbum) kanoAlbum.textContent = kanoArtistByLang[currentLang];
          setPlayingUI(true);
        } catch {
          try {
            const res = await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(r.search)}&country=JP&entity=song&limit=1`);
            const data = await res.json();
            const fresh = data?.results?.[0]?.previewUrl;
            if (fresh) {
              r.preview = fresh;
              kanoAudio.src = fresh;
              await kanoAudio.play();
              clearTimeout(kanoStatusTimer);
              if (kanoAlbum) kanoAlbum.textContent = kanoArtistByLang[currentLang];
              setPlayingUI(true);
              return;
            }
          } catch {
            // Audio playback blocked or unavailable offline
          }
          setPlayingUI(false);
          if (kanoAlbum) {
            clearTimeout(kanoStatusTimer);
            kanoAlbum.textContent = i18nData[currentLang].previewUnavailable;
            kanoStatusTimer = window.setTimeout(() => {
              if (kanoAlbum) kanoAlbum.textContent = kanoArtistByLang[currentLang];
            }, 2200);
          }
        }
      };

      const selectKano = (nextIdx: number, autoplay = false) => {
        kanoIdx = (nextIdx + kanoStateReleases.length) % kanoStateReleases.length;
        const r = kanoStateReleases[kanoIdx];
        if (kanoTitle) kanoTitle.textContent = r.title;
        if (kanoAlbum) kanoAlbum.textContent = kanoArtistByLang[currentLang];
        if (kanoCard) kanoCard.style.setProperty('--kano-wash', r.wash);
        if (kanoDeck) kanoDeck.style.setProperty('--disc-accent', r.accent);
        if (kanoCoverImg) {
          kanoCoverImg.src = `${kanoBase}${r.coverFile}`;
          kanoCoverImg.alt = `${r.album} cover`;
        }
        if (kanoDiscImg) kanoDiscImg.src = `${kanoBase}${r.discFile}`;
        if (kanoAudio) {
          kanoAudio.pause();
          kanoAudio.currentTime = 0;
          kanoAudio.src = r.preview;
        }
        if (autoplay || kanoPlaying) {
          void startKanoPlayback();
        } else {
          setPlayingUI(false);
        }
      };

      selectKano(pickRandomKanoIdx(), false);

      kanoPlayBtn?.addEventListener('click', () => {
        if (!kanoAudio) return;
        if (kanoPlaying && !kanoAudio.paused) {
          kanoAudio.pause();
          setPlayingUI(false);
        } else {
          void startKanoPlayback();
        }
      });

      kanoAudio?.addEventListener('ended', () => selectKano(pickRandomKanoIdx(kanoIdx), true));
      kanoDeck?.addEventListener('click', () => selectKano(pickRandomKanoIdx(kanoIdx), true));

      // GitHub Pinned Repos Click, Keyboard Navigation & Drag-and-Drop Reorder
      const pinGrid = document.getElementById('gh-pin-grid');
      if (pinGrid) {
        if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
          pinGrid.querySelectorAll('.gh-pin-card').forEach((card) => card.setAttribute('draggable', 'false'));
        }
        const saveOrder = () => {
          const order = Array.from(pinGrid.querySelectorAll('.gh-pin-card')).map((el) => el.getAttribute('data-repo'));
          localStorage.setItem('pinned_order', JSON.stringify(order));
        };
        const currentRepos = Array.from(pinGrid.querySelectorAll('.gh-pin-card')).map((el) => el.getAttribute('data-repo') || '');
        const savedOrder = JSON.parse(localStorage.getItem('pinned_order') || '[]') as string[];
        if (savedOrder.length === currentRepos.length && currentRepos.every((name) => savedOrder.includes(name))) {
          savedOrder.forEach((name) => {
            const el = pinGrid.querySelector(`[data-repo="${name}"]`);
            if (el) pinGrid.appendChild(el);
          });
        } else if (savedOrder.length) {
          localStorage.removeItem('pinned_order');
        }
        let draggedCard: HTMLElement | null = null;
        let lastDragEndAt = 0;
        pinGrid.addEventListener('dragstart', (e) => {
          draggedCard = (e.target as HTMLElement).closest('.gh-pin-card');
          if (!draggedCard) return;
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', draggedCard.getAttribute('data-repo') || '');
          }
          draggedCard.classList.add('dragging');
        });
        pinGrid.addEventListener('dragend', () => {
          draggedCard?.classList.remove('dragging');
          draggedCard = null;
          lastDragEndAt = Date.now();
          saveOrder();
        });
        pinGrid.addEventListener('click', (e) => {
          if (Date.now() - lastDragEndAt < 200) return;
          const target = e.target as HTMLElement | null;
          if (!target || target.closest('a, button, input, label, .proj-toy, .gh-grip')) return;
          if (window.getSelection()?.toString()) return;
          const card = target.closest('.gh-pin-card') as HTMLElement | null;
          const repoUrl = card?.getAttribute('data-url');
          if (repoUrl) window.open(repoUrl, '_blank', 'noopener,noreferrer');
        });
        pinGrid.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          const card = (e.target as HTMLElement | null)?.closest('.gh-pin-card') as HTMLElement | null;
          if (!card || e.target !== card) return;
          e.preventDefault();
          const repoUrl = card.getAttribute('data-url');
          if (repoUrl) window.open(repoUrl, '_blank', 'noopener,noreferrer');
        });
        pinGrid.addEventListener('drop', (e) => {
          e.preventDefault();
          saveOrder();
        });
        pinGrid.addEventListener('dragover', (e) => {
          e.preventDefault();
          const target = (e.target as HTMLElement).closest('.gh-pin-card') as HTMLElement | null;
          if (!draggedCard || !target || target === draggedCard) return;
          const cards = Array.from(pinGrid.children);
          if (cards.indexOf(draggedCard) < cards.indexOf(target)) {
            target.after(draggedCard);
          } else {
            target.before(draggedCard);
          }
          saveOrder();
        });
      }

      // Photography polaroid tape peel interaction & reset pill
      const photoResetBtn = document.getElementById('photo-reset') as HTMLButtonElement | null;
      const photoWraps = Array.from(document.querySelectorAll<HTMLElement>('.polaroid-wrap'));
      const peelTimers = new Map<HTMLElement, number[]>();
      const syncPhotoReset = () => {
        if (!photoResetBtn) return;
        photoResetBtn.hidden = !photoWraps.some((w) => w.classList.contains('peeled') || w.querySelector('.photo-tape.peeling'));
      };
      document.querySelectorAll('.photo-tape').forEach((tape) => {
        tape.addEventListener('click', () => {
          const wrap = tape.closest('.polaroid-wrap') as HTMLElement | null;
          if (!wrap || wrap.classList.contains('peeled')) return;
          tape.classList.add('peeling');
          syncPhotoReset();
          const t1 = window.setTimeout(() => {
            wrap.classList.add('peeled');
            syncPhotoReset();
            const t2 = window.setTimeout(() => {
              if (wrap.classList.contains('peeled')) {
                wrap.style.display = 'none';
                syncNotebookGrid();
              }
            }, 380);
            peelTimers.set(wrap, [t2]);
          }, 120);
          peelTimers.set(wrap, [t1]);
        });
      });
      photoResetBtn?.addEventListener('click', () => {
        photoWraps.forEach((wrap) => {
          peelTimers.get(wrap)?.forEach((id) => clearTimeout(id));
          peelTimers.delete(wrap);
          wrap.style.display = '';
          wrap.classList.remove('peeled');
          wrap.querySelector('.photo-tape')?.classList.remove('peeling');
        });
        syncPhotoReset();
        syncNotebookGrid();
      });

      // Accessible Album Modal & Fullscreen Photo Viewer with focus trap + preloading
      const albumModal = document.getElementById('album-modal');
      const albumCloseBtn = document.getElementById('album-close') as HTMLButtonElement | null;
      const albumTitle = document.getElementById('album-title');
      const albumSubtitle = document.getElementById('album-subtitle');
      const albumPhotos = document.getElementById('album-photos');
      const albumsData = (window as any).__ALBUMS__ || [];

      const photoViewer = document.getElementById('photo-viewer');
      const viewerCloseBtn = document.getElementById('viewer-close') as HTMLButtonElement | null;
      const viewerCounter = document.getElementById('viewer-counter');
      const viewerImg = document.getElementById('viewer-img') as HTMLImageElement | null;
      const viewerCredit = document.getElementById('viewer-credit') as HTMLAnchorElement | null;
      let currentPhotos: string[] = [];
      let currentAlbumName = '';
      let currentCredits: Record<string, { label: string; url: string }> = {};
      let currentIdx = 0;
      let lastAlbumTrigger: HTMLElement | null = null;
      let lastViewerTrigger: HTMLElement | null = null;

      /** Trap Tab navigation inside an active modal dialog. */
      const trapFocus = (container: HTMLElement | null, e: KeyboardEvent) => {
        if (!container || e.key !== 'Tab') return;
        const focusables = Array.from(
          container.querySelectorAll<HTMLElement>('button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])')
        ).filter((el) => el.offsetParent !== null);
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      };

      const showSlide = (idx: number) => {
        if (!currentPhotos.length || !viewerImg) return;
        currentIdx = (idx + currentPhotos.length) % currentPhotos.length;
        const src = currentPhotos[currentIdx];
        viewerImg.src = src;
        viewerImg.alt = `${currentAlbumName} (${currentIdx + 1}/${currentPhotos.length})`;
        if (viewerCounter) viewerCounter.textContent = `${currentIdx + 1} / ${currentPhotos.length}`;
        if (currentPhotos.length > 1) {
          const preloadNext = new Image();
          preloadNext.src = currentPhotos[(currentIdx + 1) % currentPhotos.length];
          const preloadPrev = new Image();
          preloadPrev.src = currentPhotos[(currentIdx - 1 + currentPhotos.length) % currentPhotos.length];
        }
        const c = currentCredits[src];
        if (viewerCredit) {
          if (c) {
            viewerCredit.textContent = c.label;
            viewerCredit.href = c.url;
            viewerCredit.classList.add('visible');
          } else {
            viewerCredit.classList.remove('visible');
          }
        }
      };

      const closeViewer = () => {
        photoViewer?.classList.remove('open');
        lastViewerTrigger?.focus({ preventScroll: true });
      };

      const closeAlbum = () => {
        albumModal?.classList.remove('open');
        if (!profileWin?.classList.contains('fullscreen')) {
          document.body.style.overflow = '';
        }
        lastAlbumTrigger?.focus({ preventScroll: true });
      };

      document.querySelectorAll('.polaroid-card').forEach((card) => {
        card.addEventListener('click', () => {
          card.classList.add('is-pressing');
          window.setTimeout(() => card.classList.remove('is-pressing'), 160);
          const slug = card.getAttribute('data-album');
          const album = albumsData.find((a: any) => a.slug === slug);
          if (!album || !albumModal || !albumPhotos || !albumTitle || !albumSubtitle) return;
          lastAlbumTrigger = card as HTMLElement;
          currentAlbumName = album.title;
          albumTitle.textContent = album.title;
          albumSubtitle.textContent = album.kind === 'Other' ? 'Composite' : album.date;
          currentPhotos = album.photos || [];
          const gridThumbs: string[] = album.thumbs || currentPhotos;
          const thumbSizes: [number, number][] = album.thumbSizes || [];
          currentCredits = album.credits || {};
          albumPhotos.innerHTML = '';
          gridThumbs.forEach((thumbSrc: string, idx: number) => {
            const fullSrc = currentPhotos[idx] || thumbSrc;
            const [tw, th] = thumbSizes[idx] || [560, 420];
            const wrap = document.createElement('div');
            wrap.className = 'album-photo-wrap';
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'album-photo-btn';
            btn.setAttribute('aria-label', `View ${album.title} photo ${idx + 1} of ${currentPhotos.length}`);
            const img = document.createElement('img');
            img.src = thumbSrc;
            img.alt = `${album.title} ${idx + 1}`;
            img.width = tw;
            img.height = th;
            img.loading = 'lazy';
            img.decoding = 'async';
            btn.appendChild(img);
            btn.addEventListener('click', () => {
              lastViewerTrigger = btn;
              showSlide(idx);
              photoViewer?.classList.add('open');
              viewerCloseBtn?.focus({ preventScroll: true });
            });
            wrap.appendChild(btn);
            const c = currentCredits[fullSrc];
            if (c) {
              const badge = document.createElement('a');
              badge.className = 'album-credit-badge';
              badge.href = c.url;
              badge.target = '_blank';
              badge.rel = 'noreferrer';
              badge.textContent = c.label;
              wrap.appendChild(badge);
            }
            albumPhotos.appendChild(wrap);
          });
          albumModal.classList.add('open');
          document.body.style.overflow = 'hidden';
          albumCloseBtn?.focus({ preventScroll: true });
        });
      });

      viewerCloseBtn?.addEventListener('click', closeViewer);
      document.getElementById('viewer-prev')?.addEventListener('click', () => showSlide(currentIdx - 1));
      document.getElementById('viewer-next')?.addEventListener('click', () => showSlide(currentIdx + 1));

      let swipeX = 0;
      let swipeY = 0;
      photoViewer?.addEventListener('touchstart', (e) => {
        swipeX = e.changedTouches[0].clientX;
        swipeY = e.changedTouches[0].clientY;
      }, { passive: true });
      photoViewer?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - swipeX;
        const dy = e.changedTouches[0].clientY - swipeY;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.2) {
          showSlide(dx > 0 ? currentIdx - 1 : currentIdx + 1);
        }
      }, { passive: true });

      document.addEventListener('keydown', (e) => {
        if (photoViewer?.classList.contains('open')) {
          if (e.key === 'ArrowLeft') showSlide(currentIdx - 1);
          else if (e.key === 'ArrowRight') showSlide(currentIdx + 1);
          else if (e.key === 'Escape') closeViewer();
          else trapFocus(photoViewer, e);
        } else if (albumModal?.classList.contains('open')) {
          if (e.key === 'Escape') closeAlbum();
          else trapFocus(albumModal, e);
        } else if (profileWin?.classList.contains('fullscreen') && e.key === 'Escape') {
          exitFullscreen();
        }
      });

      albumCloseBtn?.addEventListener('click', closeAlbum);
      albumModal?.addEventListener('click', (e) => {
        if (e.target === albumModal) closeAlbum();
      });

      // Fullscreen Ask AI interactive chat
      const chatChips = document.querySelector('.chat-chips');
      const aiSubmit = document.getElementById('ai-submit');
      aiSubmit?.addEventListener('click', () => {
        if (profileWin?.classList.contains('fullscreen')) {
          if (!selectedQuestion || !chatMessages) {
            chatChips?.classList.remove('nudge');
            void (chatChips as HTMLElement | null)?.offsetWidth;
            chatChips?.classList.add('nudge');
            return;
          }
          const u = document.createElement('div');
          u.className = 'chat-msg user';
          u.textContent = selectedQuestion;
          chatMessages.appendChild(u);

          const providerKey = ((aiProviderSel?.value || 'chatgpt') as AiProviderId);
          const provider = aiProviderMeta[providerKey] || aiProviderMeta.chatgpt;
          const b = document.createElement('div');
          b.className = 'chat-msg bot';
          const badge = document.createElement('span');
          badge.className = 'chat-provider-pill';
          badge.textContent = `${provider.label} · ${provider.tag}`;
          const langPack = i18nData[currentLang];
          const replyKey = selectedChipKey as keyof typeof langPack.replies;
          const replyBody = (replyKey && langPack.replies[replyKey]) || 'Thanks for asking!';
          b.appendChild(badge);
          b.appendChild(document.createTextNode(`${provider.prefix[currentLang]}${replyBody}`));
          chatMessages.appendChild(b);
          chatMessages.scrollTop = chatMessages.scrollHeight;

          selectedQuestion = '';
          selectedChipKey = '';
          if (chatDraft) {
            chatDraft.textContent = langPack.draftPlaceholder;
            chatDraft.classList.remove('has-text');
          }
          return;
        }
        toggleFullscreen();
      });
    </script>
  </body>
</html>
