      // GitHub Pinned Repos Drag-and-Drop Reorder
      const pinGrid = document.getElementById('gh-pin-grid');
      if (pinGrid) {
        const saveOrder = () => {
          const order = Array.from(pinGrid.querySelectorAll('.gh-pin-card')).map((el) => el.getAttribute('data-repo'));
          localStorage.setItem('pinned_order', JSON.stringify(order));
        };
        const currentRepos = Array.from(pinGrid.querySelectorAll('.gh-pin-card')).map((el) => el.getAttribute('data-repo') || '');
        const savedOrder = JSON.parse(localStorage.getItem('pinned_order') || '[]') as string[];
        if (
          savedOrder.length === currentRepos.length &&
          currentRepos.every((name) => savedOrder.includes(name))
        ) {
          savedOrder.forEach((name) => {
            const el = pinGrid.querySelector(`[data-repo="${name}"]`);
            if (el) pinGrid.appendChild(el);
          });
        } else if (savedOrder.length) {
          localStorage.removeItem('pinned_order');
        }
        let draggedCard: HTMLElement | null = null;
        pinGrid.addEventListener('dragstart', (e) => {
          draggedCard = (e.target as HTMLElement).closest('.gh-pin-card');
          if (!draggedCard) return;
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', draggedCard.getAttribute('data-repo') || '');
          }
          draggedCard.classList.add('dragging');
        });
        pinGrid.addEventListener('dragend', () => {
          draggedCard?.classList.remove('dragging');
          draggedCard = null;
          saveOrder();
        });
        pinGrid.addEventListener('drop', (e) => {
          e.preventDefault();
          saveOrder();
        });
        pinGrid.addEventListener('dragover', (e) => {
          e.preventDefault();
          const target = (e.target as HTMLElement).closest('.gh-pin-card') as HTMLElement | null;
          if (!draggedCard || !target || target === draggedCard) return;
          const cards = Array.from(pinGrid.children);
          if (cards.indexOf(draggedCard) < cards.indexOf(target)) {
            target.after(draggedCard);
          } else {
            target.before(draggedCard);
          }
          saveOrder();
        });
      }

      document.querySelectorAll('.note-tape').forEach((tape) => {
        tape.addEventListener('click', () => {
          const note = tape.closest('.sticky-note') as HTMLElement | null;
          if (!note || note.classList.contains('peeled')) return;
          tape.classList.add('peeling');
          setTimeout(() => {
            note.classList.add('peeled');
            setTimeout(() => { note.style.display = 'none'; }, 380);
          }, 120);
        });
      });

      const albumModal = document.getElementById('album-modal');
      const albumTitle = document.getElementById('album-title');
      const albumSubtitle = document.getElementById('album-subtitle');
      const albumPhotos = document.getElementById('album-photos');
      const albumsData = (window as any).__ALBUMS__ || [];

      const photoViewer = document.getElementById('photo-viewer');
      const viewerImg = document.getElementById('viewer-img') as HTMLImageElement | null;
      const viewerCredit = document.getElementById('viewer-credit') as HTMLAnchorElement | null;
      let currentPhotos: string[] = [];
      let currentCredits: Record<string, { label: string; url: string }> = {};
      let currentIdx = 0;

      const showSlide = (idx: number) => {
        if (!currentPhotos.length || !viewerImg) return;
        currentIdx = (idx + currentPhotos.length) % currentPhotos.length;
        const src = currentPhotos[currentIdx];
        viewerImg.src = src;
        const c = currentCredits[src];
        if (viewerCredit) {
          if (c) {
            viewerCredit.textContent = c.label;
            viewerCredit.href = c.url;
            viewerCredit.classList.add('visible');
          } else {
            viewerCredit.classList.remove('visible');
          }
        }
      };

      document.querySelectorAll('.polaroid-card').forEach((card) => {
        card.addEventListener('click', () => {
          const slug = card.getAttribute('data-album');
          const album = albumsData.find((a: any) => a.slug === slug);
          if (!album || !albumModal || !albumPhotos || !albumTitle || !albumSubtitle) return;
          albumTitle.textContent = album.title;
          albumSubtitle.textContent = album.kind === 'Other' ? 'Composite' : album.date;
          currentPhotos = album.photos || [];
          currentCredits = album.credits || {};
          albumPhotos.innerHTML = '';
          currentPhotos.forEach((src: string, idx: number) => {
            const wrap = document.createElement('div');
            wrap.className = 'album-photo-wrap';
            const img = document.createElement('img');
            img.src = src;
            img.alt = album.title;
            img.loading = 'lazy';
            img.decoding = 'async';
            img.addEventListener('click', () => {
              showSlide(idx);
              photoViewer?.classList.add('open');
            });
            wrap.appendChild(img);
            const c = currentCredits[src];
            if (c) {
              const badge = document.createElement('a');
              badge.className = 'album-credit-badge';
              badge.href = c.url;
              badge.target = '_blank';
              badge.rel = 'noreferrer';
              badge.textContent = c.label;
              wrap.appendChild(badge);
            }
            albumPhotos.appendChild(wrap);
          });
          albumModal.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });

      document.getElementById('viewer-close')?.addEventListener('click', () => photoViewer?.classList.remove('open'));
      document.getElementById('viewer-prev')?.addEventListener('click', () => showSlide(currentIdx - 1));
      document.getElementById('viewer-next')?.addEventListener('click', () => showSlide(currentIdx + 1));

      let swipeX = 0;
      photoViewer?.addEventListener('touchstart', (e) => {
        swipeX = e.changedTouches[0].clientX;
      }, { passive: true });
      photoViewer?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - swipeX;
        if (Math.abs(dx) > 40) {
          showSlide(dx > 0 ? currentIdx - 1 : currentIdx + 1);
        }
      }, { passive: true });

      document.addEventListener('keydown', (e) => {
        if (photoViewer?.classList.contains('open')) {
          if (e.key === 'ArrowLeft') showSlide(currentIdx - 1);
          if (e.key === 'ArrowRight') showSlide(currentIdx + 1);
          if (e.key === 'Escape') photoViewer.classList.remove('open');
        } else if (albumModal?.classList.contains('open') && e.key === 'Escape') {
          closeAlbum();
        }
      });

      const closeAlbum = () => {
        albumModal?.classList.remove('open');
        if (!profileWin?.classList.contains('fullscreen')) {
          document.body.style.overflow = '';
        }
      };
      document.getElementById('album-close')?.addEventListener('click', closeAlbum);
      albumModal?.addEventListener('click', (e) => {
        if (e.target === albumModal) closeAlbum();
      });

      const chatChips = document.querySelector('.chat-chips');
      const aiSubmit = document.getElementById('ai-submit');
      aiSubmit?.addEventListener('click', () => {
        if (profileWin?.classList.contains('fullscreen')) {
          if (!selectedQuestion || !chatMessages) {
            chatChips?.classList.remove('nudge');
            void (chatChips as HTMLElement | null)?.offsetWidth;
            chatChips?.classList.add('nudge');
            return;
          }
          const u = document.createElement('div');
          u.className = 'chat-msg user';
          u.textContent = selectedQuestion;
          chatMessages.appendChild(u);
          const b = document.createElement('div');
          b.className = 'chat-msg bot';
          const langPack = i18nData[currentLang];
          const replyKey = selectedChipKey as keyof typeof langPack.replies;
          b.textContent = (replyKey && langPack.replies[replyKey]) || 'Thanks for asking!';
          chatMessages.appendChild(b);
          chatMessages.scrollTop = chatMessages.scrollHeight;
          selectedQuestion = '';
          selectedChipKey = '';
          if (chatDraft) {
            chatDraft.textContent = langPack.draftPlaceholder;
            chatDraft.classList.remove('has-text');
          }
          return;
        }
        toggleFullscreen();
      });

      // 5) Miu Runner Mini Arcade Game
      (() => {
        const canvas = document.getElementById('miu-canvas') as HTMLCanvasElement | null;
        const overlay = document.getElementById('game-overlay');
        const overlayTitle = document.getElementById('game-overlay-title');
        const overlaySub = document.getElementById('game-overlay-sub');
        const startBtn = document.getElementById('game-start-btn');
        const scoreEl = document.getElementById('game-score');
        const bestEl = document.getElementById('game-best');
        if (!canvas || !overlay || !startBtn) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let state: 'idle' | 'running' | 'gameover' = 'idle';
        let score = 0;
        let best = Number(localStorage.getItem('miu_best') || localStorage.getItem('croc_best') || '0');
        if (bestEl) bestEl.textContent = String(best);

        let W = 680;
        let H = 200;
        const groundY = 166;
        let speed = 290;
        let player = { x: 64, y: groundY - 40, vy: 0, w: 40, h: 40, jumps: 0 };
        let blushTimer = 0;
        let idleTime = 0;
        let obstacles: { x: number; w: number; h: number; kind: 'tripod' | 'cone' | 'bug' }[] = [];
        let stars: { x: number; y: number; r: number; rot: number; collected: boolean }[] = [];
        let dust: { x: number; y: number; vx: number; vy: number; life: number; color: string }[] = [];
        let spawnTimer = 0.9;
        let groundOffset = 0;
        let lastTime = 0;
        let rafId = 0;

        const fitCanvas = () => {
          const rect = canvas.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = Math.max(300, Math.round(rect.width));
          H = 200;
          canvas.width = W * dpr;
          canvas.height = H * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        fitCanvas();
        window.addEventListener('resize', fitCanvas);

        const spawnDust = (x: number, y: number, color: string, count = 6) => {
          for (let i = 0; i < count; i++) {
            dust.push({
              x,
              y,
              vx: -60 - Math.random() * 90,
              vy: -30 - Math.random() * 80,
              life: 0.35 + Math.random() * 0.2,
              color,
            });
          }
        };

        const jump = () => {
          if (state !== 'running') {
            startGame();
            return;
          }
          if (player.jumps < 2) {
            player.vy = player.jumps === 0 ? -515 : -445;
            player.jumps++;
            spawnDust(player.x + player.w * 0.4, player.y + player.h - 2, player.jumps === 2 ? '#e79cc2' : '#9a7ad6', 7);
          }
        };

        const drawMiuCharacter = (cx: number, cy: number, nowSec: number, isDark: boolean) => {
          const airborne = player.y < groundY - player.h - 1;
          const bob = airborne ? 0 : state === 'running' ? Math.abs(Math.sin(groundOffset * 0.08)) * -2.8 : Math.sin(nowSec * 3.1) * 2.2;
          const tilt = airborne
            ? Math.max(-0.2, Math.min(0.2, player.vy * 0.00034))
            : state === 'running'
              ? Math.sin(groundOffset * 0.08) * 0.05
              : 0;
          const earFold = blushTimer > 0 || player.jumps >= 2 || state === 'gameover' ? 0.28 : 0;
          const blink = (nowSec % 3.4) > 3.24 && state !== 'gameover';

          ctx.save();
          ctx.translate(cx, cy + bob);
          ctx.rotate(tilt);

          // Miu signature pink-lavender orbital aura ring behind character
          const auraGrad = ctx.createRadialGradient(0, 0, 4, 0, 0, 24);
          auraGrad.addColorStop(0, 'rgba(181, 155, 232, 0.42)');
          auraGrad.addColorStop(1, 'rgba(231, 156, 194, 0)');
          ctx.fillStyle = auraGrad;
          ctx.beginPath();
          ctx.arc(0, 0, 24, 0, Math.PI * 2);
          ctx.fill();

          ctx.save();
          ctx.rotate(nowSec * (state === 'running' ? 2.2 : 0.7));
          ctx.strokeStyle = isDark ? 'rgba(247, 179, 209, 0.75)' : 'rgba(226, 134, 176, 0.78)';
          ctx.lineWidth = 1.6;
          ctx.setLineDash([7, 4]);
          ctx.beginPath();
          ctx.arc(0, 0, 20.5, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();

          // Fluttering pastel scarf tail
          const wave = state === 'running' ? Math.sin(groundOffset * 0.14) * 4 : Math.sin(nowSec * 3.5) * 2;
          ctx.fillStyle = '#b59be8';
          ctx.beginPath();
          ctx.moveTo(-8, 4);
          ctx.quadraticCurveTo(-20, 3 + wave, -22, 10 + wave * 0.6);
          ctx.quadraticCurveTo(-14, 11, -7, 9);
          ctx.closePath();
          ctx.fill();

          // Little boots
          const stride = airborne ? 3 : state === 'running' ? Math.sin(groundOffset * 0.16) * 4 : 0;
          ctx.fillStyle = '#5c4b8a';
          ctx.beginPath();
          ctx.roundRect(-7 + stride, 13, 5.5, 5.5, 2.5);
          ctx.roundRect(1.5 - stride, 13, 5.5, 5.5, 2.5);
          ctx.fill();

          // Cute cat ears (animated fold on double-jump / blush)
          const drawEar = (side: -1 | 1) => {
            ctx.save();
            ctx.translate(side * 8.5, -10);
            ctx.rotate(side * earFold);
            ctx.fillStyle = '#faf7ff';
            ctx.strokeStyle = '#7c5cc4';
            ctx.lineWidth = 1.4;
            ctx.beginPath();
            ctx.moveTo(-4 * side, 2);
            ctx.lineTo(1.5 * side, -9.5);
            ctx.lineTo(5 * side, 3.5);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#f5a3c7';
            ctx.beginPath();
            ctx.moveTo(-1.8 * side, 1.5);
            ctx.lineTo(1.3 * side, -6);
            ctx.lineTo(3.2 * side, 2);
            ctx.closePath();
            ctx.fill();
            ctx.restore();
          };
          drawEar(-1);
          drawEar(1);

          // Main Miu chibi body / silver-lilac head
          ctx.fillStyle = '#faf7ff';
          ctx.strokeStyle = '#7c5cc4';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.roundRect(-13.5, -11, 27, 25, 12);
          ctx.fill();
          ctx.stroke();

          // Forehead hair tuft + tiny pink ribbon clip
          ctx.fillStyle = '#ebe3ff';
          ctx.beginPath();
          ctx.moveTo(-11, -6);
          ctx.quadraticCurveTo(-3, -1, 0, -5);
          ctx.quadraticCurveTo(4, -1, 11, -6);
          ctx.quadraticCurveTo(6, -11, 0, -11);
          ctx.quadraticCurveTo(-6, -11, -11, -6);
          ctx.fill();

          // Rosy cheek blush
          ctx.fillStyle = blushTimer > 0 ? 'rgba(244, 130, 178, 0.92)' : 'rgba(244, 154, 190, 0.65)';
          ctx.beginPath();
          ctx.ellipse(-7.8, 3.5, 2.7, 1.4, 0, 0, Math.PI * 2);
          ctx.ellipse(7.8, 3.5, 2.7, 1.4, 0, 0, Math.PI * 2);
          ctx.fill();

          // Expressive eyes
          ctx.strokeStyle = '#473c6e';
          ctx.fillStyle = '#473c6e';
          ctx.lineWidth = 1.6;
          ctx.lineCap = 'round';
          if (state === 'gameover') {
            ctx.beginPath();
            ctx.moveTo(-6.5, -1); ctx.lineTo(-3, 0.8); ctx.lineTo(-6.5, 2.6);
            ctx.moveTo(6.5, -1); ctx.lineTo(3, 0.8); ctx.lineTo(6.5, 2.6);
            ctx.stroke();
          } else if (blushTimer > 0) {
            ctx.beginPath();
            ctx.arc(-5, 1.2, 2.4, Math.PI * 1.1, Math.PI * 1.9);
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(5, 1.2, 2.4, Math.PI * 1.1, Math.PI * 1.9);
            ctx.stroke();
          } else if (blink) {
            ctx.beginPath();
            ctx.moveTo(-7.2, 0.5); ctx.lineTo(-2.8, 0.5);
            ctx.moveTo(2.8, 0.5); ctx.lineTo(7.2, 0.5);
            ctx.stroke();
          } else {
            ctx.beginPath();
            ctx.ellipse(-5, 0.4, 1.9, 2.7, 0, 0, Math.PI * 2);
            ctx.ellipse(5, 0.4, 1.9, 2.7, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(-5.6, -0.7, 0.8, 0, Math.PI * 2);
            ctx.arc(4.4, -0.7, 0.8, 0, Math.PI * 2);
            ctx.fill();
          }

          // Cute cat-smile mouth
          ctx.strokeStyle = '#7c5cc4';
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.arc(0, 4.2, 1.8, 0.1 * Math.PI, 0.9 * Math.PI);
          ctx.stroke();

          ctx.restore();
        };

        const startGame = () => {
          fitCanvas();
          state = 'running';
          score = 0;
          blushTimer = 0;
          speed = 295;
          player = { x: Math.min(64, W * 0.14), y: groundY - 40, vy: 0, w: 40, h: 40, jumps: 0 };
          obstacles = [];
          stars = [];
          dust = [];
          spawnTimer = 0.85;
          if (scoreEl) scoreEl.textContent = '0';
          overlay.classList.add('is-hidden');
          lastTime = performance.now();
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(loop);
        };

        const endGame = () => {
          state = 'gameover';
          const finalScore = Math.floor(score);
          if (finalScore > best) {
            best = finalScore;
            localStorage.setItem('miu_best', String(best));
            if (bestEl) bestEl.textContent = String(best);
          }
          if (overlayTitle) overlayTitle.textContent = `Game Over · ${finalScore}`;
          if (overlaySub) overlaySub.textContent = `Best: ${best}`;
          startBtn.textContent = '↻ Play Again';
          overlay.classList.remove('is-hidden');
        };

        const drawScene = (nowMs = performance.now()) => {
          const nowSec = nowMs * 0.001;
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          const gridCol = isDark ? 'rgba(90, 105, 130, 0.18)' : 'rgba(185, 205, 225, 0.42)';
          const ink = isDark ? '#e6edf3' : '#2c3440';
          const muted = isDark ? '#8d96a0' : '#6e7b8b';
          const accentBlue = isDark ? '#8cb4dc' : '#4f759b';
          const accentPink = isDark ? '#f29ec8' : '#d96b9e';

          ctx.clearRect(0, 0, W, H);

          // Subtle scrolling graph lines
          ctx.strokeStyle = gridCol;
          ctx.lineWidth = 1;
          const step = 32;
          const ox = -(groundOffset % step);
          ctx.beginPath();
          for (let x = ox; x < W; x += step) {
            ctx.moveTo(x, 0);
            ctx.lineTo(x, H);
          }
          for (let y = 24; y < H; y += step) {
            ctx.moveTo(0, y);
            ctx.lineTo(W, y);
          }
          ctx.stroke();

          // Ground horizon line
          ctx.strokeStyle = muted;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(0, groundY);
          ctx.lineTo(W, groundY);
          ctx.stroke();

          // Collectible Sakura Stars
          stars.forEach((s) => {
            if (s.collected) return;
            ctx.save();
            ctx.translate(s.x, s.y);
            ctx.rotate(s.rot + nowSec * 1.6);
            ctx.fillStyle = '#f59dc7';
            for (let i = 0; i < 5; i++) {
              ctx.save();
              ctx.rotate((i * 2 * Math.PI) / 5);
              ctx.beginPath();
              ctx.ellipse(0, -s.r * 0.56, s.r * 0.36, s.r * 0.55, 0, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            }
            ctx.fillStyle = '#fde047';
            ctx.beginPath();
            ctx.arc(0, 0, s.r * 0.28, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          });

          // Obstacles (Tripod camera, Pink Cone, Bug block)
          obstacles.forEach((o) => {
            const bx = o.x;
            const by = groundY - o.h;
            if (o.kind === 'cone') {
              ctx.fillStyle = accentPink;
              ctx.beginPath();
              ctx.moveTo(bx + o.w / 2, by);
              ctx.lineTo(bx + o.w - 2, groundY - 4);
              ctx.lineTo(bx + 2, groundY - 4);
              ctx.closePath();
              ctx.fill();
              ctx.fillStyle = ink;
              ctx.fillRect(bx, groundY - 4, o.w, 4);
            } else if (o.kind === 'tripod') {
              ctx.strokeStyle = ink;
              ctx.lineWidth = 2.2;
              ctx.beginPath();
              ctx.moveTo(bx + o.w / 2, by + 10);
              ctx.lineTo(bx + 3, groundY);
              ctx.moveTo(bx + o.w / 2, by + 10);
              ctx.lineTo(bx + o.w - 3, groundY);
              ctx.moveTo(bx + o.w / 2, by + 10);
              ctx.lineTo(bx + o.w / 2, groundY - 2);
              ctx.stroke();
              ctx.fillStyle = accentBlue;
              ctx.fillRect(bx + 3, by, o.w - 6, 12);
              ctx.fillStyle = '#ffffff';
              ctx.beginPath();
              ctx.arc(bx + o.w / 2 + 2, by + 6, 3, 0, Math.PI * 2);
              ctx.fill();
            } else {
              ctx.fillStyle = '#7c5cc4';
              ctx.beginPath();
              ctx.roundRect(bx, by, o.w, o.h, 6);
              ctx.fill();
              ctx.fillStyle = '#ffffff';
              ctx.font = '700 9.5px monospace';
              ctx.textAlign = 'center';
              ctx.fillText('BUG', bx + o.w / 2, by + o.h / 2 + 3.5);
            }
          });

          // Pastel dust particles
          dust.forEach((d) => {
            ctx.globalAlpha = Math.max(0, d.life * 2.2);
            ctx.fillStyle = d.color;
            ctx.beginPath();
            ctx.arc(d.x, d.y, 2.6, 0, Math.PI * 2);
            ctx.fill();
            ctx.globalAlpha = 1;
          });

          // Draw Miu character
          drawMiuCharacter(player.x + player.w / 2, player.y + player.h / 2 - 2, nowSec, isDark);
        };

        const loop = (now: number) => {
          if (state !== 'running') return;
          const dt = Math.min(0.04, (now - lastTime) / 1000);
          lastTime = now;

          speed = Math.min(540, speed + dt * 11);
          score += dt * 14;
          blushTimer = Math.max(0, blushTimer - dt);
          groundOffset += speed * dt;
          if (scoreEl) scoreEl.textContent = String(Math.floor(score));

          // Player physics
          player.vy += 1550 * dt;
          player.y += player.vy * dt;
          if (player.y >= groundY - player.h) {
            if (player.jumps > 0 && player.vy > 180) {
              spawnDust(player.x + player.w * 0.5, groundY - 2, '#f29ec8', 5);
            }
            player.y = groundY - player.h;
            player.vy = 0;
            player.jumps = 0;
          }

          // Spawn obstacles & sakura stars
          spawnTimer -= dt;
          if (spawnTimer <= 0) {
            const kinds: ('tripod' | 'cone' | 'bug')[] = ['tripod', 'cone', 'bug'];
            const kind = kinds[Math.floor(Math.random() * kinds.length)];
            const w = kind === 'bug' ? 30 : 26;
            const h = kind === 'tripod' ? 34 : kind === 'cone' ? 28 : 26;
            obstacles.push({ x: W + 24, w, h, kind });
            if (Math.random() < 0.6) {
              stars.push({ x: W + 38, y: groundY - h - 42 - Math.random() * 24, r: 9, rot: Math.random() * Math.PI, collected: false });
            }
            spawnTimer = Math.max(0.75, 1.55 - (speed - 295) / 550) + Math.random() * 0.45;
          }

          // Move & collide
          const pad = 8;
          for (let i = obstacles.length - 1; i >= 0; i--) {
            const o = obstacles[i];
            o.x -= speed * dt;
            if (o.x + o.w < -20) {
              obstacles.splice(i, 1);
              continue;
            }
            if (
              player.x + pad < o.x + o.w - 3 &&
              player.x + player.w - pad > o.x + 3 &&
              player.y + pad < groundY &&
              player.y + player.h - 4 > groundY - o.h + 3
            ) {
              drawScene(now);
              endGame();
              return;
            }
          }

          for (let i = stars.length - 1; i >= 0; i--) {
            const s = stars[i];
            s.x -= speed * dt;
            if (s.x < -20) {
              stars.splice(i, 1);
              continue;
            }
            if (!s.collected && Math.hypot(player.x + player.w / 2 - s.x, player.y + player.h / 2 - s.y) < 25) {
              s.collected = true;
              score += 25;
              blushTimer = 0.85;
              spawnDust(s.x, s.y, '#f59dc7', 8);
              spawnDust(s.x, s.y, '#b59be8', 5);
            }
          }

          for (let i = dust.length - 1; i >= 0; i--) {
            const d = dust[i];
            d.x += d.vx * dt;
            d.y += d.vy * dt;
            d.life -= dt;
            if (d.life <= 0) dust.splice(i, 1);
          }

          drawScene(now);
          rafId = requestAnimationFrame(loop);
        };

        const idleLoop = (now: number) => {
          if (state !== 'idle') return;
          if (document.visibilityState === 'visible' && now - idleTime > 32) {
            idleTime = now;
            drawScene(now);
          }
          rafId = requestAnimationFrame(idleLoop);
        };
        rafId = requestAnimationFrame(idleLoop);

        startBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          startGame();
        });
        canvas.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          jump();
        });
        window.addEventListener('keydown', (e) => {
          if (state === 'running' && (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW')) {
            e.preventDefault();
            jump();
          }
        });
      })();
    </script>
  </body>
</html>
