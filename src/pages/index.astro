          if (Math.abs(dy) > 3) cordMoved = true;
          miuCord.style.setProperty('--cord-pull', `${dy.toFixed(1)}px`);
          if (dy >= 10 && !cordTriggered) {
            cordTriggered = true;
            toggleSakura();
          }
        });
        const releaseCord = () => {
          if (!cordDragging) return;
          cordDragging = false;
          miuCord.classList.remove('is-dragging');
          miuCord.style.setProperty('--cord-pull', '0px');
